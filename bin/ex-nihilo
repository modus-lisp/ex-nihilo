#!/usr/bin/env bash
# bin/ex-nihilo — serve OpenAI's image API (src/server.lisp).
#   bin/ex-nihilo [--host H] [--port 9940] [--weights /dev/shm/exn] [--device 0] [--encoder-device 1|cpu]
set -euo pipefail
ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd -P)"
exec "${EXN_SBCL:-sbcl}" --dynamic-space-size "${EXN_HEAP_MB:-16384}" --noinform --non-interactive \
  --eval '(require :asdf)' \
  --eval "(asdf:initialize-source-registry '(:source-registry (:tree \"$ROOT/../\") :inherit-configuration))" \
  --eval '(handler-bind ((warning (function muffle-warning))) (asdf:load-system "ex-nihilo/server"))' \
  --eval '(ex-nihilo:main (rest (member "--end-toplevel-options" sb-ext:*posix-argv* :test (function string=))))' --end-toplevel-options "$@"
